@page
@using MBS.Razor.Pages.AdminPage.SkillPage.Model
@using MBS.Services.Models
@using MBS.Services.Utils
@using MBS.Services.Utils.Shared
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Index

@{
    Layout = "Shared/_LayoutAdmin";
    string pageName = "Index";
    var skillPagination = Model.GetTempData<Pagination<SkillModel>>(TempDataKeys.AdminKeys.SkillPagination) ?? Model.SkillPagination;
    var skills = skillPagination.Items.ToArray();
    string searchName = Model.GetTempData<string>(TempDataKeys.SearchName) ?? Model.SearchName;
    string sortOrder = Model.GetTempData<string>(TempDataKeys.SortOrder) ?? Model.SortOrder;
    int pageSize = int.Parse(Model.GetTempData<string>(TempDataKeys.PageSize) ?? Model.Size.ToString());
    int pageIndex = int.Parse(Model.GetTempData<string>(TempDataKeys.PageIndex) ?? Model.PageIndex.ToString());
}

<div class="container-fluid my-4">
    <div class="row">
        <!-- Skills Table Section -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header d-flex align-items-center justify-content-between bg-primary text-white">
                    <h5 class="mb-0">Skills</h5>
                    <form class="d-flex" method="post" asp-page-handler="Search">
                        <select class="custom-select mr-2" name="sortOrder" asp-for="SortOrder">
                            <option value="asc" selected>Asc</option>
                            <option value="desc">Desc</option>
                        </select>
                        <input type="text" class="form-control mr-2" placeholder="Search..." asp-for="SearchName">
                        <button class="btn btn-light" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Skill Name</th>
                                <th>Mentor Name</th>
                                <th>Mentor Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!skills.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No skills available</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var skill in skills)
                                {
                                    <tr role="button" onclick="location.href='@Url.Page(pageName, PageHandlers.ShowSkillDetails, new { skillId = skill.id })'">
                                        <td>@skill.Name</td>
                                        <td>@skill.MentorName</td>
                                        <td>@skill.MentorEmail</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Pagination Controls -->
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <div>
                        <label class="mb-0 mr-2" for="pageSize">Page Size:</label>
                        <select id="pageSize" class="form-control d-inline w-auto" name="size" asp-for="@Model.Size" onchange="document.getElementById('paginationForm').submit()">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                        </select>
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(skillPagination.PageIndex == 1 ? "disabled" : "")">
                                <button type="button" class="page-link" aria-label="Previous" onclick="updatePageIndex(@(skillPagination.PageIndex - 1))">Prev</button>
                            </li>
                            @for (int i = 1; i <= skillPagination.TotalPages; i++)
                            {
                                <li class="page-item @(skillPagination.PageIndex == i ? "active" : "")">
                                    <button type="button" class="page-link" onclick="updatePageIndex(@i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(skillPagination.PageIndex == skillPagination.TotalPages ? "disabled" : "")">
                                <button type="button" class="page-link" aria-label="Next" onclick="updatePageIndex(@(skillPagination.PageIndex + 1))">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Create New Skill Section -->
        <div class="col-lg-4">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Create New Skill</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Create" id="createSkillForm">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="ChosenSkill.Name">Skill Name</label>
                            <input type="text" class="form-control" asp-for="ChosenSkill.Name" id="skillName" disabled>
                        </div>
                        <div class="form-group">
                            <label asp-for="ChosenSkill.MentorId">Description</label>
                            <textarea class="form-control" asp-for="ChosenSkill.MentorId" id="skillDescription" disabled></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block mt-3" id="submitSkill" disabled>Create</button>
                    </form>
                    <button class="btn btn-success btn-block mt-2" id="createSkillButton">Enable Form</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createSkillButton').addEventListener('click', function () {
            document.getElementById('skillName').disabled = false;
            document.getElementById('skillDescription').disabled = false;
            document.getElementById('submitSkill').disabled = false;
        });

        function updatePageIndex(index) {
            document.getElementById('hiddenPageIndex').value = index;
            document.getElementById('paginationForm').submit();
        }

        function onChangeSubmit() {
            document.getElementById('paginationForm').submit();
        }
    </script>
}

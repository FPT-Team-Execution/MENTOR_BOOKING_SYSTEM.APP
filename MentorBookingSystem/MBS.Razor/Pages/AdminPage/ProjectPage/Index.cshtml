@page
@model MBS.Razor.Pages.AdminPage.ProjectPage.Index
@using MBS.Razor.Pages.AdminPage.ProjectPage.Models
@using MBS.Services.Models
@using MBS.Services.Utils
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "Shared/_LayoutAdmin";
    string pageName = "Index";
    //Student Pagination
    var projectPagination = Model.GetTempData<Pagination<ProjectModel>>(TempDataKeys.AdminKeys.ProjectPagination)! ?? Model.ProjectPagination;
    var projects = projectPagination.Items.ToArray();
    //Get search & sort Order
    string search = Model.GetTempData<string>(TempDataKeys.SearchName) ?? Model.search;

    //Get size and index
    int pageSize = int.Parse(Model.GetTempData<string>(TempDataKeys.PageSize) ?? Model.Size.ToString());
    int pageIndex = int.Parse(Model.GetTempData<string>(TempDataKeys.PageIndex) ?? Model.PageIndex.ToString());
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
    <div>
        <div class="table-responsive">
            <table class="table table-hover ">
                <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Title</th>
                        <th scope="col">Description</th>
                        <th scope="col">Due Date</th>
                        <th scope="col">Semester</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (!projects.Any())
                        {
                            <tr>
                                <td colspan="8">No projects available</td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < projects.Count(); i++)
                            {
                                var project = projects[i];
                                var index = projectPagination.PageSize * (pageIndex - 1) + (i + 1);
                                <tr id="@project.Id" role="button">
                                    <th scope="row">@index</th>
                                    <td>@project.Title</td>
                                    <td>@project.Description</td>
                                    <td>@project.DueDate</td>
                                    <td>@project.Semester</td>
                                    <td>@project.Status</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
@page
@model MBS.Razor.Pages.AdminPage.ProjectPage.CreateModel
@{
    ViewData["Title"] = "Create Project";
    Layout = "Shared/_LayoutAdmin";
}

<h2 class="text-center">Create Project</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                <div class="form-group">
                    <label asp-for="Project.Title"></label>
                    <input asp-for="Project.Title" class="form-control" />
                    <span asp-validation-for="Project.Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Project.Description"></label>
                    <textarea asp-for="Project.Description" class="form-control"></textarea>
                    <span asp-validation-for="Project.Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Project.Semester"></label>
                    <input asp-for="Project.Semester" class="form-control" />
                    <span asp-validation-for="Project.Semester" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Project.MentorId"></label>
                    <input asp-for="Project.MentorId" class="form-control" />
                    <span asp-validation-for="Project.MentorId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Create</button>
            </form>
        </div>
    </div>
</div>

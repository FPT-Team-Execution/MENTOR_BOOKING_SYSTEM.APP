@page
@model MBS.Razor.Pages.AdminPage.ProjectPage.CreateModel
@{
    ViewData["Title"] = "Create Project";
    Layout = "Shared/_LayoutAdmin";
}

<h2 class="text-center">Create Project</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                <!-- Project Title -->
                <div class="form-group">
                    <label asp-for="Project.Title"></label>
                    <input asp-for="Project.Title" class="form-control" />
                    <span asp-validation-for="Project.Title" class="text-danger"></span>
                </div>

                <!-- Project Description -->
                <div class="form-group">
                    <label asp-for="Project.Description"></label>
                    <textarea asp-for="Project.Description" class="form-control"></textarea>
                    <span asp-validation-for="Project.Description" class="text-danger"></span>
                </div>

                <!-- Project Semester -->
                <div class="form-group">
                    <label asp-for="Project.Semester"></label>
                    <input asp-for="Project.Semester" class="form-control" />
                    <span asp-validation-for="Project.Semester" class="text-danger"></span>
                </div>

                <!-- Mentor Search and Selection -->
                <div class="form-group">
                    <label for="mentorSearch">Search Mentor</label>
                    <input type="text" id="mentorSearch" class="form-control" placeholder="Type mentor name..." oninput="filterMentors()" />
                    <div id="mentorResults" class="list-group mt-2"></div>
                </div>

                <!-- Mentor ID Field -->
                <div class="form-group">
                    <label asp-for="Project.MentorId"></label>
                    <input asp-for="Project.MentorId" class="form-control" readonly />
                    <span asp-validation-for="Project.MentorId" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary w-100">Create</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Get mentors from the server-side model
        const mentors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Mentors));

        function filterMentors() {
            const query = document.getElementById("mentorSearch").value.toLowerCase();
            const resultsContainer = document.getElementById("mentorResults");
            resultsContainer.innerHTML = ""; // Clear previous results

            mentors
                .filter(mentor => mentor.FullName.toLowerCase().includes(query))
                .forEach(mentor => {
                    const item = document.createElement("a");
                    item.classList.add("list-group-item", "list-group-item-action");
                    item.textContent = mentor.FullName;
                    item.href = "#";
                    item.onclick = (e) => {
                        e.preventDefault();
                        selectMentor(mentor.Id, mentor.FullName);
                    };
                    resultsContainer.appendChild(item);
                });
        }

        function selectMentor(id, name) {
            document.getElementById("Project_MentorId").value = id;
            document.getElementById("mentorSearch").value = name;
            document.getElementById("mentorResults").innerHTML = ""; // Clear search results
        }
    </script>
}
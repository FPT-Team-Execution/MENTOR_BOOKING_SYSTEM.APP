@page
@using MBS.Razor.Pages.AdminPage.MentorPage.Models
@using MBS.Razor.Pages.AdminPage.StudentPage.Models
@using MBS.Services.Models
@using MBS.Services.Utils
@using Microsoft.AspNetCore.Mvc.TagHelpers

@model Index

@{
    Layout = "Shared/_LayoutAdmin";
    string pageName = "Index";

    //Student Pagination 
    var mentorPagination = Model.GetTempData<Pagination<MentorModel>>(TempDataKeys.AdminKeys.MentorPagination)! ?? Model.MentorPagination;
    var mentors = mentorPagination.Items.ToArray();
    //Get search & sort Order
    string searchName = Model.GetTempData<string>(TempDataKeys.SearchName) ?? Model.SearchName;
    string sortOrder = Model.GetTempData<string>(TempDataKeys.SortOrder) ?? Model.SortOrder;

    //Get size and index
    int pageSize = int.Parse(Model.GetTempData<string>(TempDataKeys.PageSize) ?? Model.Size.ToString());
    int pageIndex = int.Parse(Model.GetTempData<string>(TempDataKeys.PageIndex) ?? Model.PageIndex.ToString());
}

<div class="row h-100 my-4">
    <div class="col-lg-8">
        <div class="card h-auto">
            <div class="row align-items-center m-2">
                <div class="col">
                    <h5>Mentors</h5>
                </div>
                <div class="col-auto ml-auto d-flex">
                    <form class="form-inline border rounded navbar-search shadow-sm" method="post" asp-page-handler="Search">
                        <div class="input-group">
                            <select class="form-control bg-light border-0 small" name="sortOrder" asp-for="@sortOrder" >
                                <option value="asc" selected>Sort Ascending</option>
                                <option value="desc">Sort Descending</option>
                            </select>

                            <input type="text" class="form-control bg-light border-0 small" placeholder="Search for..."
                                   aria-label="Search" aria-describedby="basic-addon2" asp-for="SearchName">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Birthday</th>
                        <th scope="col">Points</th>
                        <th scope="col">Status</th>
                    </tr>
                    </thead>
                    <tbody>

                    @{
                        if (!mentors.Any())
                        {
                            <tr>
                                <td colspan="8">No mentors available</td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < mentors.Count(); i++)
                            {
                                var mentor = mentors[i];
                                var index = mentorPagination.PageSize * (pageIndex - 1) + (i + 1);
                                <tr id="@mentor.Id" role="button" onclick="location.href='@Url.Page(pageName, PageHandlers.ShowMentorDetails, new { mentorId = @mentor.Id })'">
                                    <th scope="row">@(i + 1)</th>
                                    <td>@mentor.FullName</td>
                                    <td>@mentor.Email</td>
                                    <td>@mentor.Birthday?.ToString("MM/dd/yyyy")</td>
                                    <td>@mentor.ConsumePoint</td>

                                    <td>
                                        <span class="badge bg-success text-white">@(mentor.LockoutEnd is null ? "Active" : "Inactive")</span>
                                    </td>

                                </tr>
                            }
                        }
                    }

                    </tbody>
                </table>
            </div>
            @* Pagination Navigaion *@
            <form id="paginationForm" method="post" asp-page-handler="PageNavigate" class="d-flex justify-content-center">
                <!-- Input hidden để lưu giá trị pageIndex hiện tại -->
                <input type="hidden" id="hiddenPageIndex" name="pageIndex" value="@mentorPagination.PageIndex"/>

                <!-- Page Size Dropdown -->
                <nav aria-label="page size" class="me-3 mr-2">
                    <select class="form-control" name="size" asp-for="@Model.Size" onchange="onChangeSubmit()">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                    </select>
                </nav>

                <!-- Pagination Controls -->
                <nav aria-label="Pagination">
                    <ul class="pagination mb-0">
                        <li class="page-item">
                            <button type="button" class="page-link @(mentorPagination.TotalItems <= pageSize ? "disable" : "") " aria-label="Previous" @(mentorPagination.PageIndex == 1 ? "disabled" : "") onclick="updatePageIndex(@(mentorPagination.PageIndex - 1))">
                                <span aria-hidden="true">Prev</span>
                            </button>
                        </li>
                        @for (int i = 1; i <= mentorPagination.TotalPages; i++)
                        {
                            <li class="page-item @(mentorPagination.PageIndex == i ? "active" : "")">
                                <button type="button" class="page-link" onclick="updatePageIndex(@i)">@i</button>
                            </li>
                        }
                        <li class="page-item">
                            <button type="button" class="page-link @(mentorPagination.TotalItems <= pageSize ? "disable" : "")" aria-label="Next" @(mentorPagination.PageIndex == mentorPagination.TotalPages ? "disabled" : "") onclick="updatePageIndex(@(mentorPagination.PageIndex + 1))">
                                <span aria-hidden="true">Next</span>
                            </button>
                        </li>
                    </ul>
                </nav>
            </form>
        </div>


    </div>
    <div class="col-lg-4 mb-4 h-100">
        <div class="card">
            <div class="card-body">
                @await Html.PartialAsync("MentorDetailPartial", Model.ChosenMentor)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updatePageIndex(newIndex) {
            document.getElementById('hiddenPageIndex').value = newIndex;
            document.getElementById('paginationForm').submit();
        }

        function onChangeSubmit() {
            document.getElementById('paginationForm').submit();
        }
    </script>
}
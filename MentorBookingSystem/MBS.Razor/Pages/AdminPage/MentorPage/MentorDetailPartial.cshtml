@using MBS.Razor.Pages.AdminPage.MentorPage.Models
@using MBS.Services.Utils
@model MBS.Razor.Pages.AdminPage.BaseAdminPage
@{
    var chosenMentor = Model.GetTempData<MentorModel>(TempDataKeys.AdminKeys.ChosenMentor, isKeep: false) ?? new MentorModel();
}

<div>
    <form>
        <div class=" mb-3">
            <div class="row g-0">
                <div class="col-md-4">
                    <img src="@chosenMentor.AvatarUrl" class="img-fluid rounded-start" alt="mentor image"/>
                </div>

                <div class="col-md-8 d-flex text-center flex-column justify-content-between" style="height: 100%;">
                    Degrees
                    <div class="card-body col-md-12 d-flex flex-column flex-grow-1 align-items-sm-start">
                        <div class="row">
                            @if (chosenMentor.Degrees is not null)
                            {
                                @foreach (var degree in chosenMentor.Degrees)
                                {
                                    <div class="col-6 d-flex align-items-center justify-content-center mb-2">
                                        <a href="@degree.ImageUrl" target="_blank" class="text-primary text-decoration-none d-flex align-items-center">
                                            <i class="fas fa-certificate"></i>
                                            <span class="d-none d-md-inline text-nowrap hover-name"> @degree.Name</span>
                                        </a>
                                    </div>
                                }
                            }

                        </div>
                    </div>

                    <!-- Ensure this input always stays at the bottom -->
                    @* <div class="col-12 form-control"> *@
                    @*     <input type="file" id="imageUpload"> *@
                    @* </div> *@
                </div>

            </div>
        </div>
        <div class="mb-3">
            <label asp-for="@chosenMentor.FullName" class="form-label">Full Name</label>
            <input asp-for="@chosenMentor.FullName" type="text" class="form-control" id="mentorName"
                   aria-describedby="emailHelp">
        </div>
        <div class="mb-3">
            <label asp-for="@chosenMentor.Email" class="form-label">Email</label>
            <input asp-for="@chosenMentor.Email" type="email" class="form-control" id="mentorEmail"
                   aria-describedby="emailHelp">
        </div>
        @* <div class="mb-3"> *@
        @*     <label for="mentorPw" class="form-label">Password</label> *@
        @*     <input value="@selectedMentor" type="password" class="form-control" id="mentorPw"> *@
        @* </div> *@
        <div class="mb-3">

            <div class="mb-3 d-flex align-items-center justify-content-between">
                <label for="mentorSkills">Skills</label>
                <input type="text" class="form-control me-2 w-75 mr-2" id="mentorSkills" placeholder="Enter skill">
                <!-- Text to create new majors -->
                <a href="#" class="text-primary">+ Add</a>
            </div>
            <div class="d-flex align-items-center flex-wrap text-white mb-2">
                <span class="badge bg-secondary d-flex align-items-center me-2 mr-2">
                    Skill 1
                    <i class="fas fa-trash-alt ms-2 ml-2 text-danger"></i>
                </span>
                <span class="badge bg-secondary d-flex align-items-center me-2 mr-2">
                    Skill 2
                    <i class="fas fa-trash-alt ms-2 ml-2 text-danger"></i>
                </span>
                <span class="badge bg-secondary d-flex align-items-center me-2 mr-2">
                    Skill 3
                    <i class="fas fa-trash-alt ms-2 ml-2 text-danger"></i>
                </span>
            </div>


        </div>
        <div class="mb-3">
            <div class="mb-3 d-flex align-items-center justify-content-between">
                <label for="mentorMajors">Majors</label>
                <input type="text" class="form-control me-2 w-75 mr-2" id="mentorMajors" placeholder="Enter major">
                <!-- Text to create new majors -->
                <a href="#" class="text-primary">+ Add</a>
            </div>

            <div class="d-flex align-items-center flex-wrap text-white mb-2">
                @if (chosenMentor.Majors is not null)
                {
                    @foreach (var major in chosenMentor.Majors)
                    {
                        <span class="badge bg-secondary d-flex align-items-center me-2 mr-2">
                            @major.Name
                            <i class="fas fa-trash-alt ms-2 ml-2 text-danger"></i>
                        </span>
                    }
                }
            </div>


        </div>

        <div class="mb-3">
            <label asp-for="@chosenMentor.Birthday" class="form-label">Birthday</label>
            <input asp-for="@chosenMentor.Birthday" value="@ConvertUtils.FormatDateTimeToString(chosenMentor.Birthday)"
                   type="date" class="form-control" id="mentorIndustry">
        </div>

        <div class="mb-3">
            <label asp-for="@chosenMentor.Industry" class="form-label">Industry</label>
            <input asp-for="@chosenMentor.Industry" type="text" class="form-control" id="mentorIndustry">
        </div>

        <div class="mb-3 pl-0 form-check d-flex justify-content-start">
            <div class="w-auto mr-2">
                <label asp-for="@chosenMentor.LockoutEnabled" class="form-label">Status</label>
                <select asp-for="@chosenMentor.LockoutEnabled" class="form-control">
                    <option value="active">Active</option>
                    <option value="inactive">Locked</option>
                </select>
            </div>
            <div class="w-75">
                <label asp-for="@chosenMentor.ConsumePoint" class="form-label">Point</label>
                <input asp-for="@chosenMentor.ConsumePoint" type="number" class="form-control" id="mentorPoint"
                       aria-describedby="emailHelp">
            </div>
        </div>
        <div class="d-flex justify-content-start">
            @* <button class="btn btn-primary mr-2" type="submit" name="action" value="create">Create</button> *@
            <button class="btn btn-primary mr-2" type="submit" name="action" value="update">Update</button>
            @* <button class="btn btn-danger mr-2" type="submit" name="action" value="delete">Delete</button> *@
        </div>
    </form>
</div>
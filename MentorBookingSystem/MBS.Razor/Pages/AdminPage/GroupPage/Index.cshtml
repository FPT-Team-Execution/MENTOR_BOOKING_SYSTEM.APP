@page
@using MBS.Razor.Pages.AdminPage.GroupPage.Model
@using MBS.Services.Models
@using MBS.Services.Utils
@using MBS.DataAccess.Pagination
@using MBS.Services.Utils.Shared
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Index
@{
    Layout = "Shared/_LayoutAdmin";
    string pageName = "Index";
    // Load các giá trị từ TempData
    var groupPagination = Model.GetTempData<Pagination<GroupModel>>(TempDataKeys.AdminKeys.GroupPagination)! ?? Model.GroupPagination;
    var groups = groupPagination.Items.ToArray();
    string searchName = Model.GetTempData<string>(TempDataKeys.SearchName) ?? Model.SearchName;
    string sortOrder = Model.GetTempData<string>(TempDataKeys.SortOrder) ?? Model.SortOrder;
    int pageSize = int.Parse(Model.GetTempData<string>(TempDataKeys.PageSize) ?? Model.Size.ToString());
    int pageIndex = int.Parse(Model.GetTempData<string>(TempDataKeys.PageIndex) ?? Model.PageIndex.ToString());
}

<div class="row h-100 my-4">
    <div class="col-lg-8">
        <!-- Card hiển thị danh sách Groups -->
        <div class="card shadow-sm border-0 rounded-lg h-auto">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Groups</h5>
                <div class="d-flex">
                    <form class="form-inline mr-2" method="post" asp-page-handler="Search">
                        <div class="input-group">
                            <select class="form-control" name="sortOrder" asp-for="@sortOrder">
                                <option value="asc" selected>Sort Ascending</option>
                                <option value="desc">Sort Descending</option>
                            </select>
                            <input type="text" class="form-control ml-2" placeholder="Search for..." aria-label="Search" asp-for="SearchName">
                            <div class="input-group-append">
                                <button class="btn btn-light" type="submit">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                    <button class="btn btn-success" id="createGroupButton">Create Group</button>
                </div>
            </div>
            <!-- Bảng hiển thị thông tin nhóm -->
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Student Name</th>
                            <th scope="col">Project Name</th>
                            <th scope="col">Position Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (!groups.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center">No groups available</td>
                                </tr>
                            }
                            else
                            {
                                for (int i = 0; i < groups.Count(); i++)
                                {
                                    var group = groups[i];
                                    var index = groupPagination.PageSize * (pageIndex - 1) + (i + 1);
                                    <tr id="@group.id" role="button" onclick="location.href='@Url.Page(pageName, PageHandlers.ShowGroupDetails, new { groupId = @group.id })'">
                                        <th scope="row">@index</th>
                                        <td>@group.StudentName</td>
                                        <td>@group.ProjectName</td>
                                        <td>@group.PositionName</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            <!-- Phân trang -->
            <form id="paginationForm" method="post" asp-page-handler="PageNavigate" class="d-flex justify-content-center my-3">
                <input type="hidden" id="hiddenPageIndex" name="pageIndex" value="@groupPagination.PageIndex" />
                <div class="d-flex align-items-center">
                    <label class="mr-2 mb-0" for="pageSize">Page Size:</label>
                    <select id="pageSize" class="form-control" name="size" asp-for="@Model.Size" onchange="onChangeSubmit()">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                    </select>
                </div>
                <nav aria-label="Pagination" class="ml-3">
                    <ul class="pagination mb-0">
                        <li class="page-item">
                            <button type="button" class="page-link @(groupPagination.TotalItems <= pageSize ? "disable" : "")" aria-label="Previous" @(groupPagination.PageIndex == 1 ? "disabled" : "") onclick="updatePageIndex(@(groupPagination.PageIndex - 1))">
                                <span aria-hidden="true">Prev</span>
                            </button>
                        </li>
                        @for (int i = 1; i <= groupPagination.TotalPages; i++)
                        {
                            <li class="page-item @(groupPagination.PageIndex == i ? "active" : "")">
                                <button type="button" class="page-link" onclick="updatePageIndex(@i)">@i</button>
                            </li>
                        }
                        <li class="page-item">
                            <button type="button" class="page-link @(groupPagination.TotalItems <= pageSize ? "disable" : "")" aria-label="Next" @(groupPagination.PageIndex == groupPagination.TotalPages ? "disabled" : "") onclick="updatePageIndex(@(groupPagination.PageIndex + 1))">
                                <span aria-hidden="true">Next</span>
                            </button>
                        </li>
                    </ul>
                </nav>
            </form>
        </div>
    </div>

    <!-- Form tạo nhóm mới -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Create New Group</h5>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="Create" id="createGroupForm">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="ChosenGroup.ProjectId">Project ID</label>
                        <input type="text" class="form-control" asp-for="ChosenGroup.ProjectId" id="projectId" disabled>
                    </div>
                    <div class="form-group">
                        <label asp-for="ChosenGroup.StudentId">Student ID</label>
                        <input type="text" class="form-control" asp-for="ChosenGroup.StudentId" id="studentId" disabled>
                    </div>
                    <div class="form-group">
                        <label asp-for="ChosenGroup.PositionId">Position ID</label>
                        <input type="text" class="form-control" asp-for="ChosenGroup.PositionId" id="positionId" disabled>
                    </div>
                    <button type="submit" class="btn btn-primary" id="submitGroup" disabled>Create</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createGroupButton').addEventListener('click', function () {
            document.getElementById('projectId').disabled = false;
            document.getElementById('studentId').disabled = false;
            document.getElementById('positionId').disabled = false;
            document.getElementById('submitGroup').disabled = true;

            // Check if fields are filled to enable the submit button
            const inputs = [document.getElementById('projectId'), document.getElementById('studentId'), document.getElementById('positionId')];
            inputs.forEach(input => {
                input.addEventListener('input', function () {
                    const allFilled = inputs.every(i => i.value.trim() !== "");
                    document.getElementById('submitGroup').disabled = !allFilled;
                });
            });
        });

        function updatePageIndex(newIndex) {
            document.getElementById('hiddenPageIndex').value = newIndex;
            document.getElementById('paginationForm').submit();
        }

        function onChangeSubmit() {
            document.getElementById('paginationForm').submit();
        }
    </script>
}

@page
@using MBS.Razor.Pages.AdminPage.PositionPage.Model
@using MBS.Services.Models
@using MBS.Services.Utils
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Index

@{
    Layout = "Shared/_LayoutAdmin";
    string pageName = "Index";
    var positionPagination = Model.GetTempData<Pagination<PositionModel>>(TempDataKeys.AdminKeys.PositionPagination) ?? Model.PositionPagination;
    var positions = positionPagination.Items.ToArray();
    string searchName = Model.GetTempData<string>(TempDataKeys.SearchName) ?? Model.SearchName;
    string sortOrder = Model.GetTempData<string>(TempDataKeys.SortOrder) ?? Model.SortOrder;
    int pageSize = int.Parse(Model.GetTempData<string>(TempDataKeys.PageSize) ?? Model.Size.ToString());
    int pageIndex = int.Parse(Model.GetTempData<string>(TempDataKeys.PageIndex) ?? Model.PageIndex.ToString());
}

<div class="row h-100 my-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-lg h-auto">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Positions</h5>
                <div class="d-flex">
                    <form class="form-inline mr-2" method="post" asp-page-handler="Search">
                        <div class="input-group">
                            <select class="form-control" name="sortOrder" asp-for="@sortOrder">
                                <option value="asc" selected>Sort Ascending</option>
                                <option value="desc">Sort Descending</option>
                            </select>
                            <input type="text" class="form-control ml-2" placeholder="Search for..." aria-label="Search" asp-for="SearchName">
                            <div class="input-group-append">
                                <button class="btn btn-light" type="submit">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                    <button class="btn btn-success" id="createPositionButton">Create Position</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Position Name</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!positions.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center">No positions available</td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < positions.Length; i++)
                            {
                                var position = positions[i];
                                var index = positionPagination.PageSize * (pageIndex - 1) + (i + 1);
                                <tr id="@position.Id" role="button" onclick="location.href='@Url.Page(pageName, PageHandlers.ShowPositionDetails, new { positionId = @position.Id })'">
                                    <th scope="row">@index</th>
                                    <td>@position.Name</td>
                                    <td>@position.Description</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <form id="paginationForm" method="post" asp-page-handler="PageNavigate" class="d-flex justify-content-center my-3">
                <input type="hidden" id="hiddenPageIndex" name="pageIndex" value="@positionPagination.PageIndex" />
                <div class="d-flex align-items-center">
                    <label class="mr-2 mb-0" for="pageSize">Page Size:</label>
                    <select id="pageSize" class="form-control" name="size" asp-for="@Model.Size" onchange="onChangeSubmit()">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                    </select>
                </div>
                <nav aria-label="Pagination" class="ml-3">
                    <ul class="pagination mb-0">
                        <li class="page-item @(positionPagination.PageIndex == 1 ? "disabled" : "")">
                            <button type="button" class="page-link" aria-label="Previous" onclick="updatePageIndex(@(positionPagination.PageIndex - 1))">
                                <span aria-hidden="true">Prev</span>
                            </button>
                        </li>
                        @for (int i = 1; i <= positionPagination.TotalPages; i++)
                        {
                            <li class="page-item @(positionPagination.PageIndex == i ? "active" : "")">
                                <button type="button" class="page-link" onclick="updatePageIndex(@i)">@i</button>
                            </li>
                        }
                        <li class="page-item @(positionPagination.PageIndex == positionPagination.TotalPages ? "disabled" : "")">
                            <button type="button" class="page-link" aria-label="Next" onclick="updatePageIndex(@(positionPagination.PageIndex + 1))">
                                <span aria-hidden="true">Next</span>
                            </button>
                        </li>
                    </ul>
                </nav>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-lg">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Create New Position</h5>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="Create" id="createPositionForm">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="ChosenPosition.Name">Position Name</label>
                        <input type="text" class="form-control" asp-for="ChosenPosition.Name" id="positionName" disabled>
                    </div>
                    <div class="form-group">
                        <label asp-for="ChosenPosition.Description">Description</label>
                        <textarea class="form-control" asp-for="ChosenPosition.Description" id="positionDescription" disabled></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary" id="submitPosition" disabled>Create</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createPositionButton').addEventListener('click', function () {
            document.getElementById('positionName').disabled = false;
            document.getElementById('positionDescription').disabled = false;
            document.getElementById('submitPosition').disabled = false;
        });

        function updatePageIndex(index) {
            document.getElementById('hiddenPageIndex').value = index;
            document.getElementById('paginationForm').submit();
        }

        function onChangeSubmit() {
            document.getElementById('paginationForm').submit();
        }
    </script>
}

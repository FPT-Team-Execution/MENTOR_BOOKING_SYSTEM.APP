@page
@using MBS.Services.Dtos
@using MBS.Services.Utils.Shared
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model MBS.Razor.Pages.StudentPage.ProjectPage.Index

@{
    Layout = "Shared/_LayoutStudent";
    //* get temp data
    //Members in project
    var members = Model.GetTempData<List<GroupDto>>(TempDataKeys.StudentKeys.Groups);
    members ??= new List<GroupDto>();
    var project = Model.GetTempData<ProjectDto>(TempDataKeys.StudentKeys.Project);
    //Get search & sort Order
    string searchName = Model.GetTempData<string>(TempDataKeys.SearchName) ?? Model.SearchName;
    string sortOrder = Model.GetTempData<string>(TempDataKeys.SortOrder) ?? Model.SortOrder;

    //Get size and index
    int pageSize = int.Parse(Model.GetTempData<string>(TempDataKeys.PageSize) ?? Model.Size.ToString());
    int pageIndex = int.Parse(Model.GetTempData<string>(TempDataKeys.PageIndex) ?? Model.PageIndex.ToString());
}

<div class="row">
<div class="col-lg-8 mb-2">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Members</h5>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Full Name</th>
                        <th scope="col">Position</th>
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        if (!members.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center">No member available</td>
                            </tr>
                        }
                        else
                        {
                            var memberArray = members.ToArray();
                            for (int i = 0; i < memberArray.Length; i++)
                            {
                                var group = memberArray[i];
                                <tr id="@(group.Id)" role="button">
                                    <th scope="row">@(i + 1)</th>
                                    <td>@group.StudentName</td>
                                    <td>@group.PositionName</td>
                                </tr>
                            }
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

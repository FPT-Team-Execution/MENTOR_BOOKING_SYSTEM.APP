@page
@model MBS.Razor.Pages.MentorPage.MeetingPage.CreateMeeting

@{
    ViewData["Title"] = "Accept Booking";
    Layout = "Shared/_LayoutMentor";
}

<div class="container">
    <h1>Accept Booking</h1>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form method="post">
                <div class="form-group">
                    <label asp-for="eventModel.Description"></label>
                    <input asp-for="eventModel.Description" class="form-control"/>
                    <span asp-validation-for="eventModel.Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="eventModel.IsOnline"></label>
                    <input type="checkbox" asp-for="eventModel.IsOnline" class="form-control"/>
                    <span asp-validation-for="eventModel.IsOnline" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="eventModel.Location"></label>
                    <input asp-for="eventModel.Location" class="form-control"/>
                    <span asp-validation-for="eventModel.Location" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary w-100">Create</button>
            </form>
        </div>
    </div>
</div>
@page
@model MBS.Razor.Pages.MentorPage.CalendarPage.Index

@{
    Layout = "Shared/_LayoutMentor";
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <h1>This is Mentor Calendar Page</h1>
</div>
    <div id="calendar"></div>

</body>
</html>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                events: '/MentorPage/CalendarPage/Index?handler=GoogleCalendarEvents' // Event source endpoint
            });
            calendar.render();
        });
    </script>
}

